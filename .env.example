NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Ganti di production!
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

ENCRYPTION_KEY=dev-only-32chars-long-key-123456

DB_PATH=./data/lightflow.db

# Retensi log eksekusi (hari). 0 = tidak pernah hapus otomatis.
EXECUTION_RETENTION_DAYS=30
# Rate limit webhook publik (request/IP/menit).
WEBHOOK_RATE_LIMIT=60
# Rate limit endpoint auth sensitif (login, users).
AUTH_RATE_LIMIT=20
# Set 1 jika di balik reverse proxy.
# TRUST_PROXY=1
# Jumlah file backup yang disimpan (lihat docs/backup.md).
# BACKUP_KEEP=7

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
